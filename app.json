{
  "expo": {
    "name": "Audix",
    "slug": "audix",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/brand/audix-app-icon.png",
    "scheme": "audix",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050609",
    "ios": {
      "bundleIdentifier": "com.vanillaisland.audix",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vanillaisland.audix",
      "versionCode": 1,
      "icon": "./assets/brand/audix-app-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/brand/audix-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/audix-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/brand/audix-app-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed48510a-5690-4559-a498-8a74cec62f65"
      }
    },
    "owner": "da-audix"
  }
}
