{
  "expo": {
    "name": "DA Audix",
    "slug": "audix",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "audix",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vanillaisland.audix",
    },
    "android": {
      "package": "ai.daaudix.app",
      "adaptiveIcon": {
        "backgroundColor": "#05070D",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-audio",
      "expo-document-picker",
      "expo-file-system",
      "expo-font",
      "expo-linking",
      "expo-system-ui",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#05070D"
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://bijrqoaagsvdspadrtkn.supabase.co",
      "supabasePublishableKey": "sb_publishable_qRQqDfSBUxxAqgLNxMwdDw_mDGATg7v",
      "downloadServer": "https://audix-ytdlp.onrender.com",
      "eas": {
        "projectId": "ed48510a-5690-4559-a498-8a74cec62f65"
      }
    }
  }
}
