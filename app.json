{
  "expo": {
    "name": "VOXA",
    "slug": "voxa",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/brand/voxa-app-icon.png",
    "scheme": "voxa",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050609",
    "ios": {
      "bundleIdentifier": "com.vanillaisland.voxa",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vanillaisland.voxa",
      "versionCode": 1,
      "icon": "./assets/brand/voxa-app-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/brand/voxa-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/voxa-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/brand/voxa-app-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
