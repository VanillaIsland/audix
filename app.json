{
  "expo": {
    "name": "DA Audix",
    "slug": "audix",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/brand/audix-app-icon.png",
    "scheme": "audix",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vanillaisland.audix",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Audix utilise le micro pour tes mémos vocaux, uniquement quand tu lances l'enregistrement."
      }
    },
    "android": {
      "package": "ai.daaudix.app",
      "adaptiveIcon": {
        "backgroundColor": "#05070D",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#05070D"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Audix utilise le micro pour tes mémos vocaux, uniquement quand tu lances l'enregistrement.",
          "enableBackgroundRecording": true
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://bijrqoaagsvdspadrtkn.supabase.co",
      "supabasePublishableKey": "sb_publishable_qRQqDfSBUxxAqgLNxMwdDw_mDGATg7v",
      "downloadServer": "https://audix-ytdlp.onrender.com",
      "eas": {
        "projectId": "ed48510a-5690-4559-a498-8a74cec62f65"
      }
    }
  }
}
