EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# YouTube Data API v3 — recherche uniquement. La lecture passe par l'IFrame Player.
# ATTENTION : toute variable EXPO_PUBLIC_* est compilee dans le bundle et donc
# extractible d'un .ipa/.apk. Restreins cette cle dans Google Cloud Console
# (API : YouTube Data API v3 / Application : bundle iOS + package Android).
EXPO_PUBLIC_YOUTUBE_API_KEY=

# Spotify — Client ID uniquement. Le client secret n'a RIEN a faire ici :
# il ne doit jamais quitter le dashboard Spotify ni entrer dans une app mobile.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
