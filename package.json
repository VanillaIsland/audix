    "build:android:internal": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build:web",
    "lint": "expo lint"
